{
  "title": "ng-health report (v1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "durationMs": {
      "type": "number"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "angularVersion": {
          "type": "string"
        },
        "angularMajor": {
          "type": "number"
        },
        "packageManager": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "single-app",
            "workspace"
          ]
        },
        "ssr": {
          "type": "boolean"
        },
        "nx": {
          "type": "boolean"
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "type"
            ]
          }
        }
      },
      "required": [
        "name",
        "packageManager",
        "kind",
        "ssr",
        "nx",
        "projects"
      ]
    },
    "score": {
      "type": "object",
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "weight": {
            "type": "number"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "weight",
          "checks"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "errored",
              "skipped"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "weight": {
            "type": "number"
          },
          "durationMs": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "findingCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "status",
          "weight",
          "durationMs",
          "findingCount"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "fixHint": {
            "type": "string"
          },
          "docsUrl": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "checkId": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "message",
          "fixHint",
          "checkId",
          "category",
          "fingerprint"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "medium": {
              "type": "number"
            },
            "low": {
              "type": "number"
            },
            "total": {
              "type": "number"
            }
          },
          "required": [
            "critical",
            "high",
            "medium",
            "low",
            "total"
          ]
        },
        "checks": {
          "type": "object",
          "properties": {
            "completed": {
              "type": "number"
            },
            "errored": {
              "type": "number"
            },
            "skipped": {
              "type": "number"
            }
          },
          "required": [
            "completed",
            "errored",
            "skipped"
          ]
        }
      },
      "required": [
        "findings",
        "checks"
      ]
    },
    "topFixes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "checkId": {
            "type": "string"
          },
          "checkName": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "impact": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "fixHint": {
            "type": "string"
          },
          "docsUrl": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "rank",
          "checkId",
          "checkName",
          "category",
          "severity",
          "count",
          "impact",
          "message",
          "fixHint",
          "files"
        ]
      }
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "actual": {
            "type": [
              "number",
              "string"
            ]
          },
          "expected": {
            "type": [
              "number",
              "string"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "passed",
          "expected"
        ]
      }
    },
    "passed": {
      "type": "boolean"
    },
    "trend": {
      "type": "object",
      "properties": {
        "baselineGeneratedAt": {
          "type": "string"
        },
        "baselineVersion": {
          "type": "string"
        },
        "overall": {
          "type": "object",
          "properties": {
            "before": {
              "type": "number"
            },
            "after": {
              "type": "number"
            },
            "delta": {
              "type": "number"
            }
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "before": {
                "type": "number"
              },
              "after": {
                "type": "number"
              },
              "delta": {
                "type": "number"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "newFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "column": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "fixHint": {
                "type": "string"
              },
              "docsUrl": {
                "type": "string"
              },
              "ruleId": {
                "type": "string"
              },
              "checkId": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "message",
              "fixHint",
              "checkId",
              "category",
              "fingerprint"
            ]
          }
        },
        "resolvedFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "column": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "fixHint": {
                "type": "string"
              },
              "docsUrl": {
                "type": "string"
              },
              "ruleId": {
                "type": "string"
              },
              "checkId": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "message",
              "fixHint",
              "checkId",
              "category",
              "fingerprint"
            ]
          }
        }
      },
      "required": [
        "baselineGeneratedAt",
        "baselineVersion",
        "overall",
        "categories",
        "newFindings",
        "resolvedFindings"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "generatedAt",
    "durationMs",
    "project",
    "score",
    "categories",
    "checks",
    "findings",
    "summary",
    "topFixes",
    "thresholds",
    "passed"
  ]
}
